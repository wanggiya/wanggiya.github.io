+++ b/js/stop-areas-ui.js
@@ -0,0 +1,169 @@
+import { colorEditor, bindColorEditor, rgba } from './grid-colors.js';
+
+/** Independent Voronoi overlay. It never changes grid analysis or vehicle rendering. */
+export function createStopAreasUI({ context, selectionTool, panel }) {
+  panel
+    .querySelector('.interaction-tools')
+    .insertAdjacentHTML(
+      'beforeend',
+      '<button id="open-stop-areas" type="button" aria-expanded="false">Nearest-stop areas</button>',
+    );
+  panel.insertAdjacentHTML(
+    'beforeend',
+    `
+    <section id="stop-areas-settings" class="grid-settings" hidden aria-label="Nearest-stop areas">
+      <strong>Thiessen / Voronoi polygons</strong>
+      <p class="grid-note">Each region is closest to one selected stop or station representative by straight-line distance in local meters. These are not walking-time or transit service boundaries.</p>
+      <label>Sites<select id="voronoi-grouping"><option value="stations">Group by MBTA parent station</option><option value="stops">Individual stops</option></select></label>
+      <p class="grid-note">Station representatives are the mean of their shown stops. Missing parent IDs remain individual stops. Co-located sites share one region. Stops outside the area still participate.</p>
+      <label>Coverage<select id="voronoi-scope"><option value="view">Current map view</option><option value="drawn">Drawn rectangle / polygon</option></select></label>
+      <div class="interaction-actions"><button id="voronoi-rectangle" type="button">Drag rectangle</button><button id="voronoi-polygon" type="button">Draw polygon</button></div>
+      <button id="voronoi-cancel" type="button" hidden>Cancel drawing (Esc)</button>
+      <p id="voronoi-area-status" class="grid-note">Uses the same drawn selection as the grid tools. Changing that selection does not redraw existing results.</p>
+      <div class="grid-switch-row"><span id="voronoi-toggle-label">Show stop areas</span><label class="grid-slide"><input id="voronoi-visible" type="checkbox" role="switch" aria-labelledby="voronoi-toggle-label" checked><span class="grid-slide-track" aria-hidden="true"></span></label><span id="voronoi-switch-state" class="grid-switch-status">On</span></div>
+      <details><summary>Stop-area appearance</summary>
+        ${colorEditor('voronoi-color', 'Area color', '#8056d9')}
+        <label>Fill opacity<input id="voronoi-opacity" type="range" min="0" max="0.6" step="0.05" value="0.15"></label>
+      </details>
+      <div class="interaction-actions"><button id="voronoi-draw" type="button">Calculate stop areas</button><button id="voronoi-clear" type="button">Clear stop areas</button></div>
+      <p id="voronoi-status" class="grid-note" role="status" aria-live="polite">Uses currently visible stops from selected routes. Recalculate after changing routes or stops.</p>
+      <p id="voronoi-cell-info" class="grid-note">Click a region to inspect its stop/station and area.</p>
+    </section>`,
+  );
+  const $ = (id) => document.getElementById(id);
+  const source = new ol.source.Vector();
+  const layer = new ol.layer.Vector({ source, zIndex: 1.6 });
+  layer.set('name', 'interaction-stop-areas');
+  const format = new ol.format.GeoJSON();
+  let color = '#8056d9',
+    worker = null,
+    rejectPending = null,
+    generation = 0;
+  function restyle() {
+    layer.setStyle(
+      new ol.style.Style({
+        stroke: new ol.style.Stroke({ color, width: 1.3 }),
+        fill: new ol.style.Fill({
+          color: rgba(color, Number($('voronoi-opacity').value)),
+        }),
+      }),
+    );
+  }
+  bindColorEditor($('voronoi-color'), (value) => {
+    color = value;
+    restyle();
+  });
+  $('voronoi-opacity').oninput = restyle;
+  restyle();
+  $('voronoi-visible').onchange = () => {
+    layer.setVisible($('voronoi-visible').checked);
+    $('voronoi-switch-state').textContent = layer.getVisible() ? 'On' : 'Off';
+  };
+  function cancel() {
+    worker?.terminate();
+    worker = null;
+    rejectPending?.(new DOMException('Cancelled.', 'AbortError'));
+    rejectPending = null;
+  }
+  for (const kind of ['rectangle', 'polygon'])
+    $(`voronoi-${kind}`).onclick = () => {
+      $('voronoi-scope').value = 'drawn';
+      selectionTool.beginSelection(kind);
+    };
+  $('voronoi-cancel').onclick = () => selectionTool.cancelSelection();
+  selectionTool.events.addEventListener('drawing', ({ detail }) => {
+    $('voronoi-cancel').hidden = !detail;
+    if (detail)
+      $('voronoi-area-status').textContent =
+        detail === 'rectangle'
+          ? 'Drag on the map with the left mouse button. Esc cancels.'
+          : 'Click polygon corners; double-click to finish. Esc cancels.';
+  });
+  selectionTool.events.addEventListener('selection', () => {
+    $('voronoi-area-status').textContent = 'Area selected. Click Calculate stop areas.';
+  });
+  selectionTool.events.addEventListener('clear', () => {
+    $('voronoi-area-status').textContent =
+      'The shared drawn selection was cleared. Draw a new area or choose Current map view.';
+  });
+  $('voronoi-clear').onclick = () => {
+    generation++;
+    cancel();
+    source.clear();
+    context.map.removeLayer(layer);
+    $('voronoi-draw').disabled = false;
+    $('voronoi-status').textContent = 'Stop areas cleared.';
+    $('voronoi-cell-info').textContent = 'Calculate stop areas to inspect them.';
+  };
+  $('voronoi-draw').onclick = async () => {
+    cancel();
+    const id = ++generation;
+    $('voronoi-draw').disabled = true;
+    $('voronoi-status').textContent = 'Calculating nearest-stop areas…';
+    try {
+      const mask = selectionTool.getArea($('voronoi-scope').value);
+      const snapshot = context.getVisibleNetworkSnapshot();
+      const result = await new Promise((resolve, reject) => {
+        const current = new Worker(new URL('./grid-worker.js', import.meta.url), {
+          type: 'module',
+        });
+        worker = current;
+        rejectPending = reject;
+        const finish = () => {
+          current.terminate();
+          if (worker === current) {
+            worker = null;
+            rejectPending = null;
+          }
+        };
+        current.onmessage = ({ data }) => {
+          finish();
+          data.error ? reject(Error(data.error)) : resolve(data);
+        };
+        current.onerror = (event) => {
+          event.preventDefault();
+          finish();
+          reject(
+            Error(
+              'Stop-area worker could not load. Check the JS files and local Turf bundle.',
+            ),
+          );
+        };
+        current.postMessage({
+          operation: 'voronoi',
+          mask,
+          snapshot,
+          grouping: $('voronoi-grouping').value,
+        });
+      });
+      if (id !== generation) return;
+      source.clear();
+      source.addFeatures(
+        format.readFeatures(result.regions, {
+          dataProjection: 'EPSG:4326',
+          featureProjection: context.map.getView().getProjection(),
+        }),
+      );
+      if (!context.map.getLayers().getArray().includes(layer))
+        context.map.addLayer(layer);
+      const m = result.metadata;
+      $('voronoi-status').textContent =
+        `${m.regionCount} regions · ${m.seedCount} sites from ${m.inputStops} shown stops · snapshot ${new Date(m.capturedAt).toLocaleTimeString()} · ${snapshot.loadedRoutes}/${snapshot.totalRoutes} routes loaded.`;
+      $('voronoi-cell-info').textContent =
+        'Click a region to inspect its stop/station and area.';
+    } catch (error) {
+      if (id === generation && error.name !== 'AbortError')
+        $('voronoi-status').textContent = error.message;
+    } finally {
+      if (id === generation) $('voronoi-draw').disabled = false;
+    }
+  };
+  context.map.on('singleclick', (event) => {
+    if (!layer.getVisible() || !$('voronoi-cancel').hidden) return;
+    const region = source.getFeaturesAtCoordinate(event.coordinate)[0];
+    if (!region) return;
+    const p = region.getProperties();
+    $('voronoi-cell-info').textContent =
+      `${p.name} · ${p.areaKm2.toLocaleString(undefined, { maximumFractionDigits: 3 })} km² · ${p.stopIds.length} stop(s) · site IDs: ${p.seedIds.join(', ')}. Nearest by straight-line distance to ${p.groupedByParent ? 'the representative of shown station stops' : 'the stop site'}.`;
+  });
+}
diff --git a/js/stop-voronoi.js b/js/stop-voronoi.js
new file mode 100644
index 0000000..7c19f82
--- /dev/null
+++ b/js/stop-voronoi.js
@@ -0,0 +1,116 @@
+/** Planar nearest-stop regions in local ENU meters; no walking-network claim. */
+import {
+  feature,
+  collection,
+  regionalFrame,
+  localPoint,
+  transformGeometry,
+  planarArea,
+} from './analysis-geometry.js';
+const MAX_SEEDS = 10000;
+const MAX_REGIONS = 5000;
+
+export function generateStopVoronoi(turf, { snapshot, mask, grouping = 'stations' }) {
+  if (!['stations', 'stops'].includes(grouping)) throw Error('Choose stops or stations.');
+  if (!snapshot.stops.length)
+    throw Error('No visible stops. Enable stops and at least one route first.');
+  if (snapshot.stops.length > MAX_SEEDS)
+    throw Error('Too many input stops (limit 10,000). Select fewer routes.');
+  const enu = regionalFrame();
+  const metricMask = feature(
+    transformGeometry(mask?.geometry, (p) => localPoint(p, enu)),
+  );
+  if (planarArea(metricMask.geometry) < 0.01)
+    throw Error('Choose an area larger than 0.01 m².');
+  const groups = new Map(),
+    seen = new Set();
+  // All selected stops participate, including outside the mask. This avoids edge bias.
+  for (const stop of snapshot.stops) {
+    if (seen.has(stop.id)) continue;
+    seen.add(stop.id);
+    const key = grouping === 'stations' ? stop.stationId || stop.id : stop.id;
+    if (!groups.has(key))
+      groups.set(key, {
+        id: key,
+        names: new Set(),
+        stopIds: [],
+        points: [],
+        groupedByParent: false,
+      });
+    const group = groups.get(key);
+    group.names.add(stop.name || stop.id);
+    group.stopIds.push(stop.id);
+    group.points.push(localPoint(stop.coordinate, enu));
+    group.groupedByParent ||= Boolean(grouping === 'stations' && stop.stationId);
+  }
+  const sites = new Map();
+  for (const group of groups.values()) {
+    const xy = [0, 1].map(
+      (axis) => group.points.reduce((a, p) => a + p[axis], 0) / group.points.length,
+    );
+    // Co-located sites have one geometric region and retain all member IDs.
+    const key = xy.map((n) => Math.round(n * 10)).join(':');
+    if (!sites.has(key))
+      sites.set(key, {
+        xy,
+        seedIds: [],
+        stopIds: [],
+        names: new Set(),
+        groupedByParent: false,
+      });
+    const site = sites.get(key);
+    site.seedIds.push(group.id);
+    site.stopIds.push(...group.stopIds);
+    for (const name of group.names) site.names.add(name);
+    site.groupedByParent ||= group.groupedByParent;
+  }
+  const points = collection(
+    [...sites.values()]
+      .sort((a, b) => a.seedIds[0].localeCompare(b.seedIds[0]))
+      .map((site) =>
+        feature(
+          { type: 'Point', coordinates: site.xy },
+          {
+            seedIds: site.seedIds,
+            stopIds: site.stopIds,
+            name: [...site.names].sort().join(' / '),
+            seedCoordinate: enu.toLonLat(site.xy),
+            groupedByParent: site.groupedByParent,
+          },
+        ),
+      ),
+  );
+  const polygons = turf.voronoi(points, { bbox: turf.bbox(metricMask) });
+  const regions = [];
+  for (const polygon of polygons.features) {
+    if (!polygon) continue;
+    const clipped = turf.intersect(collection([polygon, metricMask]));
+    if (!clipped) continue;
+    const areaKm2 = planarArea(clipped.geometry) / 1e6;
+    if (areaKm2 < 1e-8) continue;
+    if (regions.length >= MAX_REGIONS)
+      throw Error(
+        'Too many Voronoi regions (limit 5,000). Choose a smaller area or fewer routes.',
+      );
+    regions.push(
+      feature(
+        transformGeometry(clipped.geometry, (p) => enu.toLonLat(p)),
+        {
+          ...polygon.properties,
+          regionId: polygon.properties.seedIds.join('|'),
+          areaKm2,
+        },
+      ),
+    );
+  }
+  return {
+    regions: collection(regions),
+    metadata: {
+      regionCount: regions.length,
+      seedCount: sites.size,
+      inputStops: seen.size,
+      grouping,
+      capturedAt: snapshot.capturedAt,
+    },
+  };
+}
diff --git a/tests/s2-voronoi.test.mjs b/tests/s2-voronoi.test.mjs
new file mode 100644
index 0000000..ea58d44
--- /dev/null
+++ b/tests/s2-voronoi.test.mjs
@@ -0,0 +1,227 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+import { s2 } from '../vendor/s2js-1.44.0.es.js';
+import { generateS2Grid } from '../js/grid-s2.js';
+import { generateStopVoronoi } from '../js/stop-voronoi.js';
+import { analyzeGrid, DEFAULT_WEIGHTS } from '../js/grid-math.js';
+import {
+  regionalFrame,
+  feature,
+  collection,
+  transformGeometry,
+  planarArea,
+} from '../js/analysis-geometry.js';
+const context = {};
+vm.createContext(context);
+vm.runInContext(
+  fs.readFileSync(new URL('../vendor/turf-7.4.0.min.js', import.meta.url), 'utf8'),
+  context,
+);
+const turf = context.turf,
+  enu = regionalFrame();
+const snapshot = {
+  stops: [],
+  vehicles: [],
+  lines: [],
+  enabledKinds: { stops: true, vehicles: true, lines: true },
+  capturedAt: new Date().toISOString(),
+  loadedRoutes: 1,
+  totalRoutes: 1,
+};
+const settings = { type: 's2', level: 13, scope: 'view', clip: false };
+const mask = turf.bboxPolygon([-71.075, 42.34, -71.045, 42.36]);
+const grid = generateS2Grid(turf, { settings, snapshot, mask });
+assert(grid.features.length > 1);
+for (const f of grid.features) {
+  const id = s2.cellid.fromToken(f.properties.s2Token);
+  assert.equal(s2.cellid.level(id), 13);
+  assert.equal(f.properties.s2Token, s2.cellid.toToken(id));
+  assert(
+    Math.abs(
+      f.properties.areaKm2 - (s2.Cell.fromCellID(id).exactArea() * 6371008.8 ** 2) / 1e6,
+    ) < 1e-10,
+  );
+  const ring = f.geometry.coordinates[0];
+  assert.equal(ring.length, 33);
+  assert.deepEqual(ring[0], ring.at(-1));
+}
+const target = s2.cellid.parent(
+  s2.cellid.fromLatLng(s2.LatLng.fromDegrees(42.35, -71.06)),
+  13,
+);
+const ll = s2.LatLng.fromPoint(s2.Cell.fromCellID(target).center());
+const coordinate = [(ll.lng * 180) / Math.PI, (ll.lat * 180) / Math.PI];
+snapshot.stops = [{ id: 's', name: 'Stop', coordinate, modes: ['subway'] }];
+snapshot.vehicles = [{ id: 'v', coordinate, mode: 'bus' }];
+snapshot.lines = [
+  {
+    routeId: 'r',
+    mode: 'bus',
+    coordinates: [
+      [-71.08, 42.35],
+      [-71.04, 42.35],
+    ],
+  },
+];
+let result = analyzeGrid(turf, grid, snapshot, DEFAULT_WEIGHTS);
+const owner = result.grid.features.find(
+  (f) => f.properties.s2Token === s2.cellid.toToken(target),
+);
+assert.equal(owner.properties.stops, 1);
+assert.equal(owner.properties.vehicles, 1);
+assert.equal(owner.properties.vehicleDensity, 1 / owner.properties.areaKm2);
+assert.equal(
+  result.grid.features.reduce((a, f) => a + f.properties.stops, 0),
+  1,
+);
+assert(result.grid.features.some((f) => f.properties.lineKm > 0));
+console.log(
+  'PASS S2 fixed levels, string token round-trip, spherical areas, points and route analysis',
+);
+const clipped = generateS2Grid(turf, {
+  settings: { ...settings, clip: true },
+  snapshot,
+  mask,
+});
+assert(
+  Math.abs(
+    clipped.features.reduce((a, f) => a + f.properties.areaKm2, 0) -
+      turf.area(mask) / 1e6,
+  ) < 0.0001,
+);
+assert(
+  clipped.features.some(
+    (f) =>
+      f.properties.areaKm2 <
+      grid.features.find((g) => g.properties.cellId === f.properties.cellId).properties
+        .areaKm2 *
+        0.9,
+  ),
+);
+assert.deepEqual(
+  generateS2Grid(turf, { settings, snapshot, mask }).features.map(
+    (f) => f.properties.cellId,
+  ),
+  grid.features.map((f) => f.properties.cellId),
+);
+const network = generateS2Grid(turf, {
+  settings: { ...settings, scope: 'network' },
+  snapshot,
+  mask: null,
+});
+result = analyzeGrid(turf, network, snapshot, DEFAULT_WEIGHTS, 'network');
+assert(
+  result.grid.features.every(
+    (f) => f.properties.stops || f.properties.vehicles || f.properties.lineKm,
+  ),
+);
+assert.throws(
+  () => generateS2Grid(turf, { settings: { ...settings, level: 18 }, snapshot, mask }),
+  /too dense/,
+);
+assert.throws(
+  () => generateS2Grid(turf, { settings: { ...settings, level: 7 }, snapshot, mask }),
+  /level/,
+);
+assert.throws(
+  () =>
+    generateS2Grid(turf, { settings, snapshot, mask: turf.bboxPolygon([0, 0, 1, 1]) }),
+  /region/,
+);
+console.log('PASS S2 clipping, stable IDs, network union and safety limits');
+const geo = (x, y) => enu.toLonLat([x, y]);
+const localMask = feature({
+  type: 'Polygon',
+  coordinates: [
+    [
+      [0, 0],
+      [2000, 0],
+      [2000, 2000],
+      [0, 2000],
+      [0, 0],
+    ],
+  ],
+});
+const geoMask = feature(transformGeometry(localMask.geometry, (p) => enu.toLonLat(p)));
+const stop = (id, x, y, stationId = null) => ({
+  id,
+  name: id,
+  stationId,
+  coordinate: geo(x, y),
+  modes: ['bus'],
+});
+function vor(stops, mask = geoMask, grouping = 'stops') {
+  return generateStopVoronoi(turf, { snapshot: { ...snapshot, stops }, mask, grouping });
+}
+let regions = vor([stop('west', 500, 1000), stop('east', 1500, 1000)]);
+assert.equal(regions.metadata.regionCount, 2);
+for (const f of regions.regions.features)
+  assert(Math.abs(f.properties.areaKm2 - 2) < 0.001);
+const totalArea = (result) =>
+  result.regions.features.reduce((a, f) => a + f.properties.areaKm2, 0);
+assert(Math.abs(totalArea(regions) - 4) < 0.001);
+// An outside site can own the whole selected area; never drop it merely because its point is outside.
+regions = vor([stop('far', -10000, 1000), stop('near-outside', 2100, 1000)]);
+assert.equal(regions.metadata.regionCount, 1);
+assert.deepEqual(regions.regions.features[0].properties.seedIds, ['near-outside']);
+assert(Math.abs(totalArea(regions) - 4) < 0.001);
+console.log(
+  'PASS Voronoi meter-based bisectors, area conservation and outside-area competitors',
+);
+regions = vor([stop('one', 1000, 1000)]);
+assert.equal(regions.metadata.regionCount, 1);
+assert(Math.abs(totalArea(regions) - 4) < 0.001);
+regions = vor([stop('one', 1000, 1000), stop('two', 1000, 1000)]);
+assert.equal(regions.metadata.seedCount, 1);
+assert.equal(regions.regions.features[0].properties.stopIds.length, 2);
+regions = vor([stop('a', 500, 1000), stop('b', 1000, 1000), stop('c', 1500, 1000)]);
+assert.equal(regions.metadata.regionCount, 3);
+assert(Math.abs(totalArea(regions) - 4) < 0.001);
+regions = vor(
+  [
+    stop('p1', 500, 500, 'station'),
+    stop('p2', 1500, 500, 'station'),
+    stop('no-parent', 1000, 1500),
+  ],
+  geoMask,
+  'stations',
+);
+assert.equal(regions.metadata.seedCount, 2);
+assert.equal(regions.metadata.inputStops, 3);
+assert.equal(
+  regions.regions.features.find((f) => f.properties.seedIds.includes('station'))
+    .properties.stopIds.length,
+  2,
+);
+console.log(
+  'PASS lone, co-located and collinear sites; parent-station grouping and fallback',
+);
+const hole = feature({
+  type: 'Polygon',
+  coordinates: [
+    localMask.geometry.coordinates[0],
+    [
+      [750, 750],
+      [750, 1250],
+      [1250, 1250],
+      [1250, 750],
+      [750, 750],
+    ],
+  ],
+});
+regions = vor(
+  [stop('a', 500, 1000), stop('b', 1500, 1000)],
+  feature(transformGeometry(hole.geometry, (p) => enu.toLonLat(p))),
+);
+assert(Math.abs(totalArea(regions) - 3.75) < 0.001);
+assert.throws(() => vor([]), /No visible stops/);
+assert.throws(
+  () => vor(Array.from({ length: 10001 }, (_, i) => stop(String(i), 1000, 1000))),
+  /Too many/,
+);
+assert.throws(
+  () => vor([stop('a', 1000, 1000)], turf.bboxPolygon([0, 0, 1, 1])),
+  /region/,
+);
+console.log('PASS Voronoi holes, empty selection, size limits and regional validation');
